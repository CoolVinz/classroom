{
  "name": "classroom-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "bun src/server.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "owner:create": "bun src/db/create-owner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.4.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.3"
  }
}
